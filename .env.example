# ==========================================
# MacroSniper AI - Environment Configuration
# ==========================================

# Server & App Environment
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change_this_to_a_super_secret_key_macro_sniper_2026

# Database & Cache (PostgreSQL + Redis)
# Local SQLite fallback works out of the box if Postgres is not running:
DATABASE_URL=sqlite+aiosqlite:///./macrosniper.db
# DATABASE_URL=postgresql+asyncpg://sniper_admin:sniper_secret@localhost:5432/macrosniper_db
REDIS_URL=redis://localhost:6379/0

# Fast Macro & Calendar Data Providers
# Primary: Financial Modeling Prep (FMP)
FMP_API_KEY=your_fmp_api_key_here
# Secondary / Real-Time: Finnhub
FINNHUB_API_KEY=your_finnhub_api_key_here
# AlphaVantage / ForexFactory backup
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here

# Telegram Bot & VIP Channels
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_VIP_CHANNEL_ID=-1001234567890
TELEGRAM_FREE_CHANNEL_ID=-1009876543210
TELEGRAM_ADMIN_IDS=123456789,987654321

# Audio & Speech AI (FOMC Live Streaming)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# MetaTrader 5 Bridge
MT5_ENABLED=false
MT5_SERVER=YourBroker-Live
MT5_LOGIN=1234567
MT5_PASSWORD=YourPassword
MT5_PATH=/path/to/metatrader5/terminal64.exe

# Risk Management Defaults
DEFAULT_SPREAD_BUFFER_GOLD=1.80
DEFAULT_ATR_PERIOD=14
KILL_SWITCH_AUTO_EXECUTE=true
