# ===== MacroSniper v2 =====
APP_ENV=development

# Local: SQLite. Production: free Neon Postgres URL (postgres://... with ?sslmode=require is fine)
DATABASE_URL=sqlite+aiosqlite:///./macrosniper.db
DATA_DIR=./data_cache

# Telegram (@BotFather). Admin IDs: your numeric Telegram ID(s), comma-separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Optional public channel for teasers and results (bot must be an admin there), e.g. @my_channel
TELEGRAM_CHANNEL_ID=
MINI_APP_URL=https://macrosniper-ai.onrender.com/miniapp

# X-Admin-Token for /api/admin/*; leave empty to disable the admin HTTP API
ADMIN_API_TOKEN=

# Optional: automatic 'actual' values (otherwise admins send /actual in the bot)
FMP_API_KEY=
# Optional free key (data.bls.gov/registrationEngine): NFP/CPI actuals polled every 1.5 s instead of 5 s
BLS_API_KEY=

# Subscription price in Telegram Stars and its length
VIP_PRICE_STARS=500
VIP_DAYS=30
# Free VIP: /promo CODE in the bot, once per person, for PROMO_LIMIT people
PROMO_CODE=
PROMO_LIMIT=2
PROMO_DAYS=30
CONVICTION_THRESHOLD=50
